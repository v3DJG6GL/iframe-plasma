<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
                          http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>
    <group name="General">
        <entry name="urlsJson" type="String">
            <default>[{"label":"KDE","url":"https://www.kde.org"}]</default>
        </entry>
        <entry name="currentTabIndex" type="Int">
            <default>0</default>
        </entry>
        <entry name="autoCycleEnabled" type="Bool">
            <default>false</default>
        </entry>
        <entry name="autoCycleIntervalSec" type="Int">
            <default>30</default>
        </entry>
    </group>
    <group name="Display">
        <entry name="zoomFactor" type="Int">
            <default>100</default>
        </entry>
        <entry name="themeMode" type="String">
            <default>auto</default>
        </entry>
        <entry name="showTabBar" type="Bool">
            <default>true</default>
        </entry>
        <entry name="compactPreviewEnabled" type="Bool">
            <default>true</default>
        </entry>
        <!-- Long-axis size of the panel-slot preview in pixels. On a
             horizontal panel this is the slot's WIDTH (height = panel
             thickness, set by Plasma). On a vertical panel this is the
             slot's HEIGHT (width = panel thickness). On the desktop both
             axes inherit this as the implicit size. -->
        <entry name="compactPreviewLongAxisPx" type="Int">
            <default>160</default>
        </entry>
        <!-- When true, the popup ignores window-deactivation and stays
             open after the user switches to another window. Toggled
             from the popup toolbar's pin button; survives plasmashell
             restart. Default false (Plasma's standard auto-close). -->
        <entry name="popupPinned" type="Bool">
            <default>false</default>
        </entry>
    </group>
    <group name="Auth">
        <!-- Named auth profiles (UUID-keyed). Each profile has metadata
             (id, name, authType, username, autheliaHost); the secret value
             is stored in KWallet under `profile:<uuid>` with multi-field
             content (password / bearerToken / rawHeader). URLs reference a
             profile by its id in urlsJson.authProfileId. -->
        <entry name="authProfilesJson" type="String">
            <default>[]</default>
        </entry>
        <!-- Monotonic counter bumped by ConfigAuth whenever a KWallet
             entry is written or removed. main.qml watches it via the
             standard KConfig change-notification path (the SecretsBridge
             QML signal can't cross the dialog/widget engine boundary).
             On bump, primeAuthProfiles + reloadAll fire so a freshly-
             entered password immediately re-arms the interceptor and
             any tab sitting on a 401/Authelia page re-requests with
             the new Authorization header. Not user-visible; excluded
             from Backup export (transient session state). -->
        <entry name="authProfilesSecretsSerial" type="Int">
            <default>0</default>
        </entry>
    </group>
    <group name="Advanced">
        <entry name="userAgentOverride" type="String">
            <default></default>
        </entry>
        <entry name="remoteDebuggingPort" type="Int">
            <default>0</default>
        </entry>
        <!-- webViewFreezeDelaySec: seconds a not-observed popup tab waits
             before it is frozen (JS/timers suspended); it is discarded
             (renderer subprocess killed, memory reclaimed) after
             popupDiscardDelaySec. webViewDiscardDelaySec: the same discard
             step for panel thumbnails, which freeze after
             thumbnailFreezeDelaySec. Set a discard delay very high to
             effectively freeze-only. See WebViewLifecycle.qml. -->
        <entry name="webViewFreezeDelaySec" type="Int">
            <default>30</default>
        </entry>
        <entry name="webViewDiscardDelaySec" type="Int">
            <default>600</default>
        </entry>
        <!-- Panel thumbnail: seconds a thumbnail that rotated out (or was
             switched away from) stays Active before it is frozen. Short on purpose:
             with the auto-cycle a tab returns within one rotation, so a delay
             longer than that never fires. Popup tabs use webViewFreezeDelaySec. -->
        <entry name="thumbnailFreezeDelaySec" type="Int">
            <default>5</default>
        </entry>
        <!-- Panel thumbnail: reload a thumbnail that sat Frozen at least this
             many seconds when it is shown again. 0 = never; it resumes as-is
             (Grafana refreshes itself on becoming visible). A failed/blank
             thumbnail always reloads. -->
        <entry name="thumbnailReloadAfterSec" type="Int">
            <default>0</default>
        </entry>
        <!-- Panel thumbnail: minutes after which a thumbnail renderer process
             is recycled (discarded right after the thumbnail freezes; it reloads
             fresh on its next appearance). Bounds renderer memory growth, e.g.
             the Qt WebEngine 6.10 GC regression. 0 = never. -->
        <entry name="thumbnailRecycleMin" type="Int">
            <default>120</default>
        </entry>
        <!-- Popup: seconds a frozen popup tab waits before it is discarded
             (renderer process shut down; it reloads when shown again). Plasma
             keeps the popup alive after closing, so this bounds how long closed
             popup tabs hold memory. -->
        <entry name="popupDiscardDelaySec" type="Int">
            <default>900</default>
        </entry>
    </group>
</kcfg>
